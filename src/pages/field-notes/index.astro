---
export const prerender = true;

import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const notes = (await getCollection("fieldNotes", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);

const formatDate = (date: Date) => new Intl.DateTimeFormat("en", {
  day: "numeric",
  month: "short",
  year: "numeric",
}).format(date);
---

<BaseLayout
  title="Field Notes on Education & Progress | Muhammad Naveed Ishaque"
  description="Practical notes on learning, multilingual education, educational systems, responsible AI and human progress."
  canonicalPath="/field-notes"
  noindex={true}
>
  <section class="field-notes-index section" aria-labelledby="field-notes-title">
    <div class="container">
      <header class="field-notes-index__header flow">
        <p class="eyebrow">Field Notes on Education & Progress</p>
        <h1 id="field-notes-title">Ideas tested against real educational questions.</h1>
        <p class="lede">
          Concise writing on learning, multilingual access, educational systems, responsible AI and the practical
          work of helping people move forward.
        </p>
      </header>

      <div class="field-notes-index__list">
        {notes.map((note, index) => (
          <article class="field-note-entry">
            <p class="field-note-entry__number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</p>
            <div class="field-note-entry__main">
              <p class="eyebrow">{note.data.category}</p>
              <h2><a href={`/field-notes/${note.id}`}>{note.data.title}</a></h2>
              <p>{note.data.description}</p>
            </div>
            <div class="field-note-entry__meta">
              <time datetime={note.data.publishedAt.toISOString()}>{formatDate(note.data.publishedAt)}</time>
              <span>{note.data.readingMinutes} min read</span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
