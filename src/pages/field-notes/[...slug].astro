---
export const prerender = true;

import { getCollection, render, type CollectionEntry } from "astro:content";
import FieldNoteLayout from "../../layouts/FieldNoteLayout.astro";

export async function getStaticPaths() {
  const notes = await getCollection("fieldNotes", ({ data }) => !data.draft);
  return notes.map((note) => ({
    params: { slug: note.id },
    props: { note },
  }));
}

interface Props {
  note: CollectionEntry<"fieldNotes">;
}

const { note } = Astro.props;
const { Content } = await render(note);
---

<FieldNoteLayout
  title={note.data.title}
  description={note.data.description}
  category={note.data.category}
  publishedAt={note.data.publishedAt}
  readingMinutes={note.data.readingMinutes}
  canonicalPath={`/field-notes/${note.id}`}
>
  <Content />
</FieldNoteLayout>
