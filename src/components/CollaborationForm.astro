---
const audiences = [
  "Individual learner",
  "Group of learners",
  "Teacher or tutor",
  "Academy or training centre",
  "Educational organisation",
  "Community",
  "Business or workforce",
  "Other",
];

const routes = [
  "Educational consultation",
  "Learning-programme development",
  "Course and curriculum support",
  "Digital learning experience",
  "Responsible AI for education",
  "Academy improvement",
  "Educational content collaboration",
  "Community-learning initiative",
];
---

<section class="collaboration-form section" aria-labelledby="collaboration-form-title">
  <div class="container collaboration-form__layout">
    <aside class="collaboration-form__guide flow" aria-labelledby="collaboration-guide-title">
      <p class="eyebrow">A useful first conversation</p>
      <h2 id="collaboration-guide-title">You bring the context. We begin with understanding.</h2>
      <p>
        You do not need a technical brief or a ready-made solution. Explain who needs support, what is happening
        today and what better would look like.
      </p>
      <div class="collaboration-form__privacy">
        <strong>Private by default at this stage</strong>
        <p>This form stays in your browser. Nothing is transmitted or silently stored.</p>
      </div>
      <a class="text-link" href="https://alnoor.aapkaustaad.com/contact.html">
        Looking for an existing AL-NOOR course? Contact the academy
      </a>
    </aside>

    <div class="collaboration-form__panel surface">
      <form data-collaboration-form novalidate>
        <div class="form-section">
          <div class="form-section__heading">
            <span aria-hidden="true">01</span>
            <div>
              <h3 id="collaboration-form-title">Your details</h3>
              <p>Fields marked <span aria-hidden="true">*</span><span class="visually-hidden">required</span> are required.</p>
            </div>
          </div>

          <div class="contact-fields contact-fields--two">
            <div>
              <label class="field-label" for="contact-name">Name <span aria-hidden="true">*</span></label>
              <input id="contact-name" name="name" autocomplete="name" maxlength="120" required />
            </div>
            <div>
              <label class="field-label" for="contact-email">Email <span aria-hidden="true">*</span></label>
              <input id="contact-email" name="email" type="email" autocomplete="email" maxlength="254" required />
            </div>
          </div>
          <label class="field-label" for="contact-organisation">Organisation, academy or role</label>
          <input id="contact-organisation" name="organisation" autocomplete="organization" maxlength="160" />
        </div>

        <div class="form-section">
          <div class="form-section__heading">
            <span aria-hidden="true">02</span>
            <div>
              <h3>The educational challenge</h3>
              <p>Ordinary language is enough. Please do not include sensitive learner information.</p>
            </div>
          </div>

          <div class="contact-fields contact-fields--two">
            <div>
              <label class="field-label" for="contact-audience">Who needs support? <span aria-hidden="true">*</span></label>
              <select id="contact-audience" name="audience" required>
                <option value="">Choose the closest fit</option>
                {audiences.map((audience) => <option>{audience}</option>)}
              </select>
            </div>
            <div>
              <label class="field-label" for="contact-route">Collaboration route <span aria-hidden="true">*</span></label>
              <select id="contact-route" name="route" required>
                <option value="">Choose a route</option>
                {routes.map((route) => <option>{route}</option>)}
              </select>
            </div>
          </div>

          <label class="field-label" for="contact-current">What is happening now? <span aria-hidden="true">*</span></label>
          <textarea id="contact-current" name="currentSituation" rows="5" minlength="10" maxlength="1200" required aria-describedby="contact-current-hint"></textarea>
          <p class="field-hint" id="contact-current-hint">Describe the difficulty, repeated work, missing information or learning need. Do not include sensitive learner details.</p>

          <label class="field-label" for="contact-outcome">What would a better outcome look like? <span aria-hidden="true">*</span></label>
          <textarea id="contact-outcome" name="betterOutcome" rows="5" minlength="10" maxlength="1200" required></textarea>
        </div>

        <div class="form-section">
          <div class="form-section__heading">
            <span aria-hidden="true">03</span>
            <div>
              <h3>Context for the next step</h3>
              <p>Add language, urgency and any useful detail.</p>
            </div>
          </div>

          <div class="contact-fields contact-fields--two">
            <div>
              <label class="field-label" for="contact-language">Preferred language <span aria-hidden="true">*</span></label>
              <select id="contact-language" name="language" required>
                <option value="">Choose a language</option>
                <option>English</option>
                <option>Español</option>
                <option>Urdu</option>
                <option>Another language</option>
              </select>
            </div>
            <div>
              <label class="field-label" for="contact-urgency">Urgency <span aria-hidden="true">*</span></label>
              <select id="contact-urgency" name="urgency" required>
                <option value="">Choose a stage</option>
                <option>Just exploring</option>
                <option>Would like to improve it soon</option>
                <option>Actively looking for a solution</option>
              </select>
            </div>
          </div>

          <label class="field-label" for="contact-message">Additional message</label>
          <textarea id="contact-message" name="message" rows="4" maxlength="1200"></textarea>

          <div class="finder-handoff" data-finder-handoff hidden>
            <div class="finder-handoff__heading">
              <div>
                <strong>Saved Education Solution Finder brief</strong>
                <p>A brief created in this browser is available. Review it before including it.</p>
              </div>
              <button class="button button--secondary" type="button" data-import-brief>Include saved brief</button>
            </div>
            <label class="field-label" for="contact-finder-brief">Finder brief</label>
            <textarea id="contact-finder-brief" name="finderBrief" rows="10" maxlength="5000" readonly></textarea>
            <button class="text-button" type="button" data-remove-brief hidden>Remove brief from this enquiry</button>
          </div>
        </div>

        <div class="status status--error" data-contact-error role="alert" hidden></div>

        <div class="contact-actions">
          <button class="button button--primary" type="button" data-copy-enquiry>Copy collaboration brief</button>
          <button class="button button--secondary" type="button" disabled aria-describedby="delivery-note">
            Secure delivery awaiting configuration
          </button>
        </div>
        <p id="delivery-note" class="contact-delivery-note">
          Nothing will be sent from this page yet. The recipient mailbox and protected Cloudflare delivery must be
          approved before secure sending is enabled.
        </p>
        <p class="finder-action-status" data-contact-status role="status" aria-live="polite"></p>
      </form>

      <details class="contact-preview" data-contact-preview hidden>
        <summary>Review copied brief</summary>
        <label class="field-label" for="contact-brief-output">Collaboration brief</label>
        <textarea id="contact-brief-output" data-contact-output rows="18" readonly></textarea>
      </details>
    </div>
  </div>
</section>

<script>
  const contactForm = document.querySelector<HTMLFormElement>("[data-collaboration-form]");

  if (contactForm) {
    const handoff = contactForm.querySelector<HTMLElement>("[data-finder-handoff]");
    const briefField = contactForm.querySelector<HTMLTextAreaElement>("[name='finderBrief']");
    const importButton = contactForm.querySelector<HTMLButtonElement>("[data-import-brief]");
    const removeButton = contactForm.querySelector<HTMLButtonElement>("[data-remove-brief]");
    const error = contactForm.querySelector<HTMLElement>("[data-contact-error]");
    const status = contactForm.querySelector<HTMLElement>("[data-contact-status]");
    const preview = document.querySelector<HTMLDetailsElement>("[data-contact-preview]");
    const output = document.querySelector<HTMLTextAreaElement>("[data-contact-output]");
    let savedBrief = "";

    try {
      savedBrief = sessionStorage.getItem("naveedEducationalBrief") || "";
    } catch {
      savedBrief = "";
    }

    if (savedBrief && handoff) handoff.hidden = false;

    importButton?.addEventListener("click", () => {
      if (!briefField || !savedBrief) return;
      briefField.value = savedBrief;
      briefField.readOnly = false;
      if (removeButton) removeButton.hidden = false;
      if (status) status.textContent = "Saved Finder brief included. Please review it before copying your enquiry.";
      briefField.focus();
    });

    removeButton?.addEventListener("click", () => {
      if (!briefField) return;
      briefField.value = "";
      briefField.readOnly = true;
      removeButton.hidden = true;
      if (status) status.textContent = "Finder brief removed from this enquiry. The saved browser copy remains available.";
    });

    contactForm.querySelector<HTMLButtonElement>("[data-copy-enquiry]")?.addEventListener("click", async () => {
      const controls = Array.from(contactForm.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>("input, select, textarea"));
      const invalid = controls.find((control) => !control.checkValidity());
      if (invalid) {
        if (error) {
          error.textContent = "Please complete the required fields before preparing the brief.";
          error.hidden = false;
        }
        invalid.setAttribute("aria-invalid", "true");
        invalid.reportValidity();
        invalid.focus();
        return;
      }

      if (error) error.hidden = true;
      controls.forEach((control) => control.removeAttribute("aria-invalid"));
      const data = new FormData(contactForm);
      const value = (name: string, fallback = "Not provided") => String(data.get(name) || fallback).trim();
      const brief = [
        "EDUCATIONAL COLLABORATION BRIEF",
        "",
        `Name: ${value("name")}`,
        `Email: ${value("email")}`,
        `Organisation, academy or role: ${value("organisation")}`,
        `Who needs support: ${value("audience")}`,
        `Collaboration route: ${value("route")}`,
        `Preferred language: ${value("language")}`,
        `Urgency: ${value("urgency")}`,
        "",
        "WHAT IS HAPPENING NOW",
        value("currentSituation"),
        "",
        "WHAT A BETTER OUTCOME WOULD LOOK LIKE",
        value("betterOutcome"),
        "",
        "ADDITIONAL MESSAGE",
        value("message"),
        ...(value("finderBrief", "") ? ["", "SAVED EDUCATION SOLUTION FINDER BRIEF", value("finderBrief", "")] : []),
      ].join("\n");

      if (output) output.value = brief;
      if (preview) {
        preview.hidden = false;
        preview.open = true;
      }

      try {
        await navigator.clipboard.writeText(brief);
        if (status) status.textContent = "Collaboration brief copied. Nothing was sent; you remain in control of where it is shared.";
      } catch {
        output?.select();
        if (status) status.textContent = "The brief is ready below. Use your browser or keyboard Copy command to copy it.";
      }
    });
  }
</script>
